# Copy this file to .env and fill in the password. .env is gitignored.
# Variables already set in the environment win over this file.
# Values are literal. Put comments on their own line. Quote a password that contains spaces.
# Leave NEO4J_URI unset when `python3 run_local.py` should start the local Docker Neo4j.
# For a real Cartography database, use a Neo4j user with the reader role.

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Empty when Neo4j has no password. Omit this line to be prompted by run_local.py.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
