# Copy this file to .env and fill in the password. .env is gitignored.
# Variables already set in the environment win over this file.
# Values are literal. Put comments on their own line. Quote a password that contains spaces.
# Leave NEO4J_URI unset when `python3 run_local.py` should start the local Docker Neo4j.
# For a real Cartography database, use a Neo4j user with the reader role.

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Empty when Neo4j has no password. Omit this line to be prompted by run_local.py.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional GraphQL source. Leave these commented so copying this file does not
# set an empty token. Data connection can write the token here. It never goes
# in gx.local.json, the log, or the page.
# Leave GRAPHQL_ENDPOINT unset when run_local.py should start the local fixture
# container gx-graphql on 127.0.0.1:8791.
# GRAPHQL_ENDPOINT=https://api.<region>.app.wiz.io/graphql  (or .wiz.us for Wiz for Government)
# GRAPHQL_CLIENT_ID=
# GRAPHQL_CLIENT_SECRET=
# GRAPHQL_AUTH_URL=
# GRAPHQL_TOKEN=
# GRAPHQL_ADAPTER=wiz
# GRAPHQL_LABEL=Wiz
# GRAPHQL_ID=wiz
# GRAPHQL_TOKEN_ENV=GRAPHQL_TOKEN
# GRAPHQL_PROJECT_ID=*
# Seconds to wait for full introspection, which the data model reads (90, at most 600).
# A Wiz schema is about 11 MB. Every other request waits 30 s.
# GRAPHQL_SCHEMA_TIMEOUT=90

# Schema cache. The data model for each connection is saved in .cache/ (gitignored),
# so a restart starts at once. No password, token, or secret is saved.
# GX_CACHE_DIR=.cache
# Seconds before a saved data model is rebuilt in the background (24 h).
# GX_CACHE_MAX_AGE=86400
# Seconds between two background schema rebuilds on a GraphQL source (20).
# GX_CACHE_GAP=20
